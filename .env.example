VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
TOKEN_ENCRYPTION_KEY=generate_32_random_bytes_as_base64url
APP_URL=http://localhost:5173

# Blogger only. Keep YouTube on a separate OAuth client.
GOOGLE_CLIENT_ID=your_google_web_oauth_client_id
GOOGLE_CLIENT_SECRET=your_server_only_google_oauth_client_secret

X_CLIENT_ID=your_x_oauth_2_client_id
X_CLIENT_SECRET=your_server_only_x_oauth_2_client_secret

# Meta app credentials can be shared; each product uses its own Login configuration.
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_server_only_meta_app_secret
META_INSTAGRAM_CONFIG_ID=your_instagram_unified_login_configuration_id
META_FACEBOOK_CONFIG_ID=your_facebook_login_for_business_configuration_id
META_GRAPH_API_VERSION=v26.0

TIKTOK_CLIENT_KEY=your_tiktok_login_kit_client_key
TIKTOK_CLIENT_SECRET=your_server_only_tiktok_client_secret
# Keep false until TikTok approves public Direct Post usage.
TIKTOK_PUBLIC_POSTING=false

# Dedicated YouTube OAuth client; do not reuse or broaden Blogger OAuth.
YOUTUBE_CLIENT_ID=your_youtube_only_google_web_oauth_client_id
YOUTUBE_CLIENT_SECRET=your_server_only_youtube_oauth_client_secret

PINTEREST_CLIENT_ID=your_pinterest_app_id
PINTEREST_CLIENT_SECRET=your_server_only_pinterest_app_secret

# Dailymotion private keys/secrets are entered by each user in Accounts and
# encrypted per connection. Only the default video category is configured here.
DAILYMOTION_CATEGORY=entertainment
